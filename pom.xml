<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.payneteasy.firewall</groupId>
    <artifactId>config</artifactId>
    <packaging>jar</packaging>
    <version>1.1-SNAPSHOT</version>
    <name>firewall-config</name>
    <url>http://maven.apache.org</url>

    <properties>
        <!-- Line coverage of the measured bundle (see the jacoco excludes below).
             This is NOT whole-tree coverage: ~31% of src/main/java is a Swing
             editor, trust-all-TLS HTTP clients, Runtime.exec("nwdiag") and CLI
             shims with System.exit, all excluded from the denominator. -->
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
    </properties>

    <repositories>
        <repository>
            <id>pne</id>
            <name>payneteasy repo</name>
            <url>https://maven.pne.io</url>
        </repository>
    </repositories>

    <dependencies>

        <!-- 4.13 is the first 4.x with assertThrows; the long multi-line
             ConfigurationException messages are part of the product, so the
             tests assert on the message text, not just the exception type. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- junit only brings hamcrest-core; hasSize/hasItem/hasEntry live here -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-library</artifactId>
            <version>1.3</version>
            <scope>test</scope>
        </dependency>

        <!-- 2.x refuses global !!com.foo tags by default; pages_history.yml is written
             with one, so every Yaml is built through util/Yamls, not `new Yaml(...)`. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.4</version>
        </dependency>

        <!-- velocity-engine-core, not velocity: 1.7 is CVE-2020-13936 and drags in
             commons-collections 3.2.1. The 2.x property names and the hyphens in
             $blocked-ip-addresses are handled in util/VelocityBuilder. -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>2.4.1</version>
        </dependency>

        <!-- velocity-engine-core logs through slf4j-api; without a provider every
             generator prints a "Failed to load StaticLoggerBinder" banner to stderr. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.18</version>
        </dependency>

        <!-- -jre, not -android: both are Java 8 compatible, -jre is the normal flavour -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.6.0-jre</version>
        </dependency>

        <!-- 3.4.4 is the last Java 8 release; 4.x needs Java 11 and moves the
             SVGGraphics2D package to org.jfree.svg. -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreesvg</artifactId>
            <version>3.4.4</version>
        </dependency>

        <dependency>
            <groupId>com.github.spullara.mustache.java</groupId>
            <artifactId>compiler</artifactId>
            <version>0.9.14</version>
        </dependency>

        <!-- direct dependency on purpose: it overrides the older 3.17.0 that
             velocity-engine-core brings in -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.7</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>

        <!-- the only HTTP stack: both Redmine clients (wiki pages and issues) go
             through it. HttpRequestParameters is what still lets RedmineEasyClient
             install its trust-all socket factory. -->
        <dependency>
            <groupId>com.payneteasy.http-client</groupId>
            <artifactId>http-client-impl</artifactId>
            <version>1.0-8</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.payneteasy.firewall.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <!-- Version-independent name: the docs, the wrapper scripts in every
                         description repo and the CI all refer to firewall-config.jar -->
                    <finalName>firewall-config</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <!-- Never set <argLine> here: it silently replaces the one
                         jacoco:prepare-agent injects and coverage drops to 0%. -->
                    <systemPropertyVariables>
                        <!-- the l2 model uses java.awt.Color/Point/Rectangle -->
                        <java.awt.headless>true</java.awt.headless>
                        <!-- so tests can find examples/demo-network from an IDE too -->
                        <basedir>${project.basedir}</basedir>
                    </systemPropertyVariables>
                    <!-- No parallel/forkCount: CreateL3Diagram writes the fixed
                         target/network.diag and the golden tests swap System.out. -->
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <!-- deliberately no <excludes>: this goal takes VM names
                             (com.foo.*), not paths, so a path list does nothing -->
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <!-- Not unit-testable, and excluded from the coverage
                                     denominator on purpose. Adding a new CLI means
                                     either testing it or adding it here. -->

                                <!-- Swing: JFrame, KeyListener, mouse drag -->
                                <exclude>com/payneteasy/firewall/l2/editor/L2Editor*</exclude>
                                <exclude>com/payneteasy/firewall/l2/editor/graphics/Swing*</exclude>
                                <exclude>com/payneteasy/firewall/l2/editor/actions/MouseMovementListener*</exclude>
                                <!-- only reachable from MainL2WireLabels -->
                                <exclude>com/payneteasy/firewall/l2/labels/**</exclude>

                                <!-- network, and a trust-all X509TrustManager -->
                                <exclude>com/payneteasy/firewall/redmine/RedmineEasyClient*</exclude>
                                <exclude>com/payneteasy/firewall/redmine/impl/**</exclude>
                                <exclude>com/payneteasy/firewall/redmine/messages/**</exclude>
                                <exclude>com/payneteasy/firewall/redmine/model/**</exclude>
                                <exclude>com/payneteasy/firewall/podmancheck/**</exclude>

                                <!-- hard-codes Runtime.exec("nwdiag ...") -->
                                <exclude>com/payneteasy/firewall/util/CommandProcess*</exclude>
                                <!-- System.exit + network -->
                                <exclude>com/payneteasy/firewall/critsoft/CritSoftCollectorMain*</exclude>

                                <!-- CLI shims: System.exit and/or Swing and/or fixed
                                     CWD-relative output paths. Main, MainBind,
                                     MainKeepalived, MainMikrotik, MainWiki and
                                     MainL3Diagram are NOT here - they are tested. -->
                                <exclude>com/payneteasy/firewall/MainL2*</exclude>
                                <exclude>com/payneteasy/firewall/MainPodmanCheck*</exclude>
                                <exclude>com/payneteasy/firewall/MainWikiDir*</exclude>
                                <exclude>com/payneteasy/firewall/MainHostLabels*</exclude>
                                <exclude>com/payneteasy/firewall/MainLinuxNetworkScript*</exclude>
                                <exclude>com/payneteasy/firewall/MainUbuntuBaseSetup*</exclude>
                                <exclude>com/payneteasy/firewall/MainExternalServices*</exclude>
                                <exclude>com/payneteasy/firewall/MainPacketsGraphviz*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <!-- LINE, not BRANCH: the SNAT decision in
                                         PacketServiceImpl is one 16-term || on a
                                         single line, i.e. 32 branches no fixture
                                         can cover. Not CLASS/METHOD either: dozens
                                         of getters exist only for Velocity. -->
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <exclude>com/payneteasy/firewall/l2/editor/L2Editor*</exclude>
                                <exclude>com/payneteasy/firewall/l2/editor/graphics/Swing*</exclude>
                                <exclude>com/payneteasy/firewall/l2/editor/actions/MouseMovementListener*</exclude>
                                <exclude>com/payneteasy/firewall/l2/labels/**</exclude>
                                <exclude>com/payneteasy/firewall/redmine/RedmineEasyClient*</exclude>
                                <exclude>com/payneteasy/firewall/redmine/impl/**</exclude>
                                <exclude>com/payneteasy/firewall/redmine/messages/**</exclude>
                                <exclude>com/payneteasy/firewall/redmine/model/**</exclude>
                                <exclude>com/payneteasy/firewall/podmancheck/**</exclude>
                                <exclude>com/payneteasy/firewall/util/CommandProcess*</exclude>
                                <exclude>com/payneteasy/firewall/critsoft/CritSoftCollectorMain*</exclude>
                                <exclude>com/payneteasy/firewall/MainL2*</exclude>
                                <exclude>com/payneteasy/firewall/MainPodmanCheck*</exclude>
                                <exclude>com/payneteasy/firewall/MainWikiDir*</exclude>
                                <exclude>com/payneteasy/firewall/MainHostLabels*</exclude>
                                <exclude>com/payneteasy/firewall/MainLinuxNetworkScript*</exclude>
                                <exclude>com/payneteasy/firewall/MainUbuntuBaseSetup*</exclude>
                                <exclude>com/payneteasy/firewall/MainExternalServices*</exclude>
                                <exclude>com/payneteasy/firewall/MainPacketsGraphviz*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
