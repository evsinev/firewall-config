-A INPUT  -p tcp -m tcp -s 10.20.22.21 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT

# node-exporter://fw-1   * --> node-exporter
-A OUTPUT -p tcp -m tcp -d 10.20.20.11 --dport 9100 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.11 --sport 9100 -m state --state RELATED,ESTABLISHED -j ACCEPT

# ssh://fw-1   * --> ssh
-A OUTPUT -p tcp -m tcp -d 10.20.20.11 --dport 22 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.11 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT

# node-exporter://fw-2   * --> node-exporter
-A OUTPUT -p tcp -m tcp -d 10.20.20.12 --dport 9100 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.12 --sport 9100 -m state --state RELATED,ESTABLISHED -j ACCEPT

# ssh://fw-2   * --> ssh
-A OUTPUT -p tcp -m tcp -d 10.20.20.12 --dport 22 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.12 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT

# dns://proxy-1   * --> internal-dns
-A OUTPUT -p udp -m udp -d 10.20.2.21 --dport 53 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p udp -m udp -s 10.20.2.21 --sport 53 -m state --state RELATED,ESTABLISHED -j ACCEPT

# node-exporter://proxy-1   * --> node-exporter
-A OUTPUT -p tcp -m tcp -d 10.20.2.21 --dport 9100 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.2.21 --sport 9100 -m state --state RELATED,ESTABLISHED -j ACCEPT

# proxy://proxy-1   * --> egress-proxy
-A OUTPUT -p tcp -m tcp -d 10.20.2.21 --dport 3128 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.2.21 --sport 3128 -m state --state RELATED,ESTABLISHED -j ACCEPT

# ssh://proxy-1   * --> ssh
-A OUTPUT -p tcp -m tcp -d 10.20.2.21 --dport 22 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.2.21 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT

# ssh://sw-core-1   * --> ssh
-A OUTPUT -p tcp -m tcp -d 10.20.6.2 --dport 22 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.6.2 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT

# https://web-1   * --> web-app
-A OUTPUT -p tcp -m tcp -d 10.20.20.21 --dport 443 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.21 --sport 443 -m state --state RELATED,ESTABLISHED -j ACCEPT

# node-exporter://web-1   * --> node-exporter
-A OUTPUT -p tcp -m tcp -d 10.20.20.21 --dport 9100 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.21 --sport 9100 -m state --state RELATED,ESTABLISHED -j ACCEPT

# ssh://web-1   * --> ssh
-A OUTPUT -p tcp -m tcp -d 10.20.20.21 --dport 22 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.21 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT


# Enable ICMP output for all interfaces
-A OUTPUT --protocol icmp --icmp-type echo-reply               -j ACCEPT
-A OUTPUT --protocol icmp --icmp-type destination-unreachable  -j ACCEPT
-A OUTPUT --protocol icmp --icmp-type echo-request             -j ACCEPT
-A OUTPUT --protocol icmp --icmp-type time-exceeded            -j ACCEPT

#
# FORWARD packets 2
#


# for tcp --reject-with tcp-reset
# for REJECT we send tcp packet with ACK and RST flags
-A OUTPUT  -p tcp -m tcp --tcp-flags ACK,RST ACK,RST -j ACCEPT

-A OUTPUT  -j LOG --log-prefix "Drop output packet:"
-A INPUT   -j LOG --log-prefix "Drop input packet:"
-A FORWARD -j LOG --log-prefix "Drop forward packet:"

# send tcp-reset for tcp connections
-A OUTPUT   -p tcp -j REJECT --reject-with tcp-reset
-A INPUT    -p tcp -j REJECT --reject-with tcp-reset
-A FORWARD  -p tcp -j REJECT --reject-with tcp-reset

# drop packets by default for other protocols

COMMIT

# default policy is ACCEPT because nat is virtual and packet pass FORWARD chain always
*nat
:PREROUTING  ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
:OUTPUT      ACCEPT [0:0]


COMMIT
