# Generated by firewall-config
*filter
:INPUT   DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT  DROP [0:0]

# loopback interface
-A INPUT  -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# simple atacks

-A INPUT -p tcp -m tcp ! --tcp-flags FIN,SYN,RST,ACK SYN -m state --state NEW -m limit --limit 5/min --limit-burst 7 -j LOG --log-prefix "Drop Sync"
-A INPUT -p tcp -m tcp ! --tcp-flags FIN,SYN,RST,ACK SYN -m state --state NEW -j DROP
-A INPUT -f -m limit --limit 5/min --limit-burst 7 -j LOG --log-prefix "Fragments Packets"
-A INPUT -p tcp -m tcp --tcp-flags FIN,SYN,RST,PSH,ACK,URG FIN,PSH,URG -j DROP
-A INPUT -p tcp -m tcp --tcp-flags FIN,SYN,RST,PSH,ACK,URG FIN,SYN,RST,PSH,ACK,URG -j DROP
-A INPUT -p tcp -m tcp --tcp-flags FIN,SYN,RST,PSH,ACK,URG NONE -m limit --limit 5/min --limit-burst 7 -j LOG --log-prefix "NULL Packets"
-A INPUT -p tcp -m tcp --tcp-flags FIN,SYN,RST,PSH,ACK,URG NONE -j DROP
-A INPUT -p tcp -m tcp --tcp-flags SYN,RST SYN,RST -j DROP
-A INPUT -p tcp -m tcp --tcp-flags FIN,SYN FIN,SYN -m limit --limit 5/min --limit-burst 7 -j LOG --log-prefix "XMAS Packets"
-A INPUT -p tcp -m tcp --tcp-flags FIN,SYN FIN,SYN -j DROP
-A INPUT -p tcp -m tcp --tcp-flags FIN,ACK FIN -m limit --limit 5/min --limit-burst 7 -j LOG --log-prefix "Fin Packets Scan"
-A INPUT -p tcp -m tcp --tcp-flags FIN,ACK FIN -j DROP
-A INPUT -p tcp -m tcp --tcp-flags FIN,SYN,RST,PSH,ACK,URG FIN,SYN,RST,ACK,URG -j DROP


#
# INPUT packets
#
# adm-1 -> node-exporter:node-exporter
-A INPUT  -i eth0 -p tcp -m tcp -s 10.20.20.31 --dport 9100 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A OUTPUT -o eth0 -p tcp -m tcp -d 10.20.20.31 --sport 9100 -m state --state RELATED,ESTABLISHED -j ACCEPT

# adm-1 -> prometheus:prometheus-ui
-A INPUT  -i eth0 -p tcp -m tcp -s 10.20.20.31 --dport 9090 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A OUTPUT -o eth0 -p tcp -m tcp -d 10.20.20.31 --sport 9090 -m state --state RELATED,ESTABLISHED -j ACCEPT

# adm-1 -> ssh:ssh
-A INPUT  -i eth0 -p tcp -m tcp -s 10.20.20.31 --dport 22 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A OUTPUT -o eth0 -p tcp -m tcp -d 10.20.20.31 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT


# Enable ICMP input for all interfaces
-A INPUT --protocol icmp --icmp-type echo-reply               -j ACCEPT
-A INPUT --protocol icmp --icmp-type destination-unreachable  -j ACCEPT
-A INPUT --protocol icmp --icmp-type echo-request             -j ACCEPT
-A INPUT --protocol icmp --icmp-type time-exceeded            -j ACCEPT


#
# OUTPUT packets
#
# node-exporter://adm-1   * --> node-exporter
-A OUTPUT -p tcp -m tcp -d 10.20.20.31 --dport 9100 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.31 --sport 9100 -m state --state RELATED,ESTABLISHED -j ACCEPT

# prometheus://adm-1   * --> prometheus-ui
-A OUTPUT -p tcp -m tcp -d 10.20.20.31 --dport 9090 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.31 --sport 9090 -m state --state RELATED,ESTABLISHED -j ACCEPT

# ssh://adm-1   * --> ssh
-A OUTPUT -p tcp -m tcp -d 10.20.20.31 --dport 22 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.20.31 --sport 22 -m state --state RELATED,ESTABLISHED -j ACCEPT

# node-exporter://db-1   * --> node-exporter
-A OUTPUT -p tcp -m tcp -d 10.20.22.21 --dport 9100 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.22.21 --sport 9100 -m state --state RELATED,ESTABLISHED -j ACCEPT

# postgres://db-1   * --> main-db
-A OUTPUT -p tcp -m tcp -d 10.20.22.21 --dport 5432 -m state --state NEW,RELATED,ESTABLISHED -j ACCEPT
-A INPUT  -p tcp -m tcp -s 10.20.22.21 --sport 5432 -m state --state RELATED,ESTABLISHED -j ACCEPT

# ssh://db-1   * --> ssh
